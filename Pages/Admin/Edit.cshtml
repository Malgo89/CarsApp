@page
@model CarsApp.Pages.Admin.EditModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Edytuj samochód";
}

<h1 class="text-center mb-4">Edytuj dane samochodu</h1>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <form method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="EditCar!.Id" value="@Model.EditCar.Id" />

                <!-- Marka -->
                <div class="mb-3">
                    <label for="Brand" class="form-label">Marka:</label>
                    <input asp-for="EditCar!.Brand" class="form-control" />
                    <span asp-validation-for="EditCar.Brand" class="text-danger"></span>
                </div>

                <!-- Model -->
                <div class="mb-3">
                    <label for="Model" class="form-label">Model:</label>
                    <input asp-for="EditCar!.Model" class="form-control" />
                    <span asp-validation-for="EditCar.Model" class="text-danger"></span>
                </div>

                <!-- Rok produkcji -->
                <div class="mb-3">
                    <label for="Year" class="form-label">Rok Produkcji:</label>
                    <input asp-for="EditCar!.Year" class="form-control" type="number" min="1900" max="2100" />
                    <span asp-validation-for="EditCar.Year" class="text-danger"></span>
                </div>

                <!-- Pasażerowie -->
                <div class="mb-3">
                    <label for="Capacity" class="form-label">Ilość miejsc poza kierowcą:</label>
                    <input asp-for="EditCar!.Capacity" class="form-control" type="number" min="1" />
                    <span asp-validation-for="EditCar.Capacity" class="text-danger"></span>
                </div>

                <!-- Aktualne zdjęcie -->
                @if (!string.IsNullOrEmpty(Model.EditCar.ImagePath))

                {
                    <div class="mb-3">
                        <label class="form-label">Aktualne zdjęcie:</label>
                        <div>
                            <img src="@Url.Content("~/" + Model.EditCar.ImagePath)" alt="Zdjęcie samochodu" class="img-fluid rounded shadow-sm" style="max-height: 200px;" />
                        </div>
                        <div class="form-check mt-2">
                            <input type="checkbox" name="DeleteImage" class="form-check-input" />
                            <label class="form-check-label" for="DeleteImage">Usuń zdjęcie</label>
                        </div>
                    </div>
                }

                <!-- Zmień zdjęcie -->
                <div class="mb-3">
                    <label for="Image" class="form-label">Zmień zdjęcie:</label>
                    <input type="file" name="file" class="form-control" />
                </div>

                <!-- Przyciski -->
                <div class="d-flex justify-content-between">
                    <a asp-page="./Index" class="btn btn-secondary">Powrót</a>
                    <input type="submit" value="Zapisz" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
