@page
@model CarsApp.Pages.Admin.CreateModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Dodaj samochód do bazy";
}

<p>Wprowadź dane samochodu:</p>

<form method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label for="Brand" class="form-label">Marka:</label>
        <input asp-for="Car!.Brand" class="form- col-md-2" />
    </div>
    <div class="mb-3">
        <label for="Model" class="form-label">Model:</label>
        <input asp-for="Car!.Model" class="form- col-md-2" />
    </div>
    <div class ="mb-3">
        <label for="Year" class="form-label">Rok Produkcji:</label>
        <input asp-for="Car!.Year" class="form- col-md-2" />
    </div>
    <div class="mb-3">
        <label for="Capacity" class="form-label">Ilość miejsc poza kierowcą:</label>
        <input asp-for="Car!.Capacity" class="form- col-md-1" />
    </div>
    <div class="mb-3">
        <label for="Image" class="form-label">Dodaj zdjęcie:</label>
        <input type="file" name="file" class="form-control" />
    </div>
    <input type="submit" value="Dodaj" />
</form>

