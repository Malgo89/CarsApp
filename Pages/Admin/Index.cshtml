@page
@model CarsApp.Pages.Admin.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Dostępne samochody";
}

<h1 class="text-center mb-4">Dostępne samochody</h1>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <form method="post">
                <table class="table table-dark table-bordered table-hover table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Marka</th>
                            <th>Model</th>
                            <th>Rok</th>
                            <th>Pasażerów</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Cars != null)
                        {
                        foreach (var car in Model.Cars)
                        {
                        <tr>
                            <td>@car.Id</td>
                            <td>@car.Brand</td>
                            <td>@car.Model</td>
                            <td>@car.Year</td>
                            <td>@car.Capacity</td>
                            <td>
                                <a asp-page="./Edit" asp-route-id="@car.Id" class="btn btn-warning btn-sm">Edytuj</a>
                                <button type="submit" asp-page-handler="delete" asp-route-id="@car.Id" class="btn btn-danger btn-sm ms-2">Usuń</button>
                            </td>
                        </tr>
                        }
                        }
                    </tbody>
                </table>
            </form>

            <div class="text-center">
                <a asp-page="Create" class="btn btn-success">Dodaj samochód</a>
            </div>
        </div>
    </div>
</div>


